<!-- Declaring the document type and setting language to English -->
<!DOCTYPE html>
<html lang="en">
<head>
    <!-- Setting character encoding for the document to UTF-8 for broad character support -->
    <meta charset="UTF-8">
    <!-- Enabling compatibility with older versions of Internet Explorer -->
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <!-- Enabling responsive scaling on various screen sizes -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- Linking to the custom stylesheet for additional styling -->
    <link rel="stylesheet" href="/css/style.css">
    <!-- Linking to Bootstrap CSS for a consistent, pre-defined style -->
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <!-- Setting the title displayed in the browser tab -->
    <title>Registered Users</title>
</head>
<body>
    <!-- Main container for centered, responsive page content -->
    <div class="container">
        <!-- Page heading for the registered users list -->
        <h2 class="mt-5">Registered Users</h2>
        
        <!-- List group for displaying each registered user’s username -->
        <ul class="list-group mt-3">
            <!-- Looping through each user in the 'users' array and rendering the username -->
            <% users.forEach(user => { %>
                <!-- Displaying each username as a Bootstrap-styled list item -->
                <li class="list-group-item"><%= user.username %></li>
            <% }) %>
        </ul>
        
        <!-- Button to navigate back to the home page -->
        <a href="/" class="btn btn-primary mt-3">Back to Home</a>
    </div>
</body>
</html>
