<!-- Declaring the document type and setting language to English -->
<!DOCTYPE html>
<html lang="en">
<head>
    <!-- Setting character encoding for the document to UTF-8 -->
    <meta charset="UTF-8">
    <!-- Making the page compatible with older versions of Internet Explorer -->
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <!-- Ensuring the page scales correctly on different screen sizes for responsive design -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- Linking to the custom stylesheet for additional styling -->
    <link rel="stylesheet" href="/css/style.css">
    <!-- Linking to Bootstrap CSS for pre-defined styles and layout options -->
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <!-- Setting the title that appears in the browser tab -->
    <title>Login</title>
</head>
<body>
    <!-- Main container for page content -->
    <div class="container">
        <!-- Page heading for the login form -->
        <h2 class="mt-5">Login</h2>
        
        <!-- Form to handle login, sending data via POST request to the /login route -->
        <form action="/login" method="POST">
            
            <!-- Form group for entering the username -->
            <div class="form-group">
                <label for="username">Username</label> <!-- Label for the username input field -->
                <!-- Input field for username, styled with Bootstrap and set as required -->
                <input type="text" class="form-control" id="username" name="username" required>
            </div>
            
            <!-- Form group for entering the password -->
            <div class="form-group">
                <label for="password">Password</label> <!-- Label for the password input field -->
                <!-- Input field for password, styled with Bootstrap and set as required -->
                <input type="password" class="form-control" id="password" name="password" required>
            </div>
            
            <!-- Submit button to log in -->
            <button type="submit" class="btn btn-primary">Login</button>
        </form>
        
        <!-- Link to the registration page for new users -->
        <div class="mt-3">
            <a href="/register" class="btn btn-success">Register</a>
        </div>
    </div>
</body>
</html>
